{
  "name": "Cartella Salute",
  "short_name": "Salute",
  "description": "Archivio personale della salute: visite, esami, pressione, peso e documenti.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b1117",
  "theme_color": "#0b1117",
  "lang": "it",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            ".csv",
            "text/csv",
            "text/comma-separated-values",
            "text/plain",
            "application/vnd.ms-excel",
            "application/octet-stream",
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}